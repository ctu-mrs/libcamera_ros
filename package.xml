<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>libcamera_ros</name>

  <version>0.2.0</version>

  <description>ROS wrapper around the raspberrypi/libcamera library.</description>

  <maintainer email="vojtech.spurny@fel.cvut.cz">Vojtech Spurny</maintainer>
  <maintainer email="tomas.baca@fel.cvut.cz">Tomas Baca</maintainer>

  <license>LGPL-2.1</license>

  <url>https://github.com/raspberrypi/libcamera</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_ros</buildtool_depend>

  <depend>git</depend>
  <depend>python3-yaml</depend>
  <depend>python3-ply</depend>
  <depend>python3-jinja2</depend>
  <depend>openssl</depend>
  <depend>yaml</depend>
  <depend>libssl-dev</depend>
